# syntax=docker/dockerfile:1.7
FROM python:3.11-slim

WORKDIR /app

# System dependencies for asyncpg, pyATS/unicon (SSH), and curl (healthcheck)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        gcc \
        g++ \
        make \
        openssh-client \
        sshpass \
        libffi-dev \
        libxml2-dev \
        libxslt1-dev \
        unzip \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ── Dynatrace OneAgent codemodule (app-only, baked into image) ──
# Layers the OneAgent runtime libs under /opt/dynatrace/oneagent
# during build using a PaaS installer token from the tenant. The
# LD_PRELOAD line in docker-compose.yml then loads the agent into
# every Python interpreter started in this container, giving us
# auto-discovery of HTTP/DB/MCP/subprocess calls with no in-app
# instrumentation. Required build inputs (from .env via compose):
#   DT_API_URL          e.g. https://kea15603.live.dynatrace.com/api (ARG — not secret)
#   DT_PAAS_TOKEN       dt0c01.... (InstallerDownload scope) — passed as a
#                       BuildKit *secret*, not an ARG. BuildKit's
#                       `--progress=plain` output (and `docker history`)
#                       shows the literal, ARG-expanded text of each RUN
#                       step, so a token passed via `ARG`/`ENV` ends up in
#                       the build log and image metadata regardless of
#                       whether the shell itself uses `set -x` — see the
#                       BuildKit `SecretsUsedInArgOrEnv` lint. Mounting it
#                       as a secret keeps the value out of both.
# include=python pulls the Python autoinstrument; include=process
# gives us the process-level metrics that feed Smartscape.
ARG DT_API_URL
# NOTE: no `-x` in `set` below either — belt-and-suspenders on top of the
# secret mount. Don't echo the token or the full installer URL anywhere
# in this block.
RUN --mount=type=secret,id=dt_paas_token \
    set -eu; \
    DT_PAAS_TOKEN="$(cat /run/secrets/dt_paas_token 2>/dev/null || true)"; \
    echo "=== OneAgent install: DT_API_URL=${DT_API_URL:+set} DT_PAAS_TOKEN=${DT_PAAS_TOKEN:+set} ==="; \
    if [ -n "${DT_API_URL:-}" ] && [ -n "${DT_PAAS_TOKEN:-}" ]; then \
        mkdir -p /opt/dynatrace/oneagent; \
        curl -fsSL -o /tmp/oneagent.zip \
            "${DT_API_URL}/v1/deployment/installer/agent/unix/paas/latest?flavor=default&include=python&include=process&Api-Token=${DT_PAAS_TOKEN}"; \
        echo "=== downloaded $(wc -c < /tmp/oneagent.zip) bytes ==="; \
        unzip -q /tmp/oneagent.zip -d /opt/dynatrace/oneagent; \
        rm /tmp/oneagent.zip; \
        echo "=== /opt/dynatrace/oneagent contents (top): $(ls -1 /opt/dynatrace/oneagent | head -5 | tr '\n' ' ') ==="; \
        echo "=== finding liboneagentproc.so:"; \
        find /opt/dynatrace -name 'liboneagentproc.so' -type f | head -5; \
    else \
        echo "!!! OneAgent install SKIPPED — args not passed !!!"; \
    fi

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

# ── Run as non-root ──────────────────────────────────────────
# Fixed uid/gid (not the next-free one `useradd` would otherwise
# pick) so it's stable across rebuilds. HOME is set explicitly to
# /home/appuser so the gcloud ADC bind mount in docker-compose.yml
# has a predictable, owned target; /app/state is where snmp_poller
# persists its minted metrics-ingest token (see services/snmp_poller.py
# — deliberately not .env, which is mounted read-only).
RUN groupadd -g 10001 appuser && \
    useradd -u 10001 -g appuser -m -d /home/appuser -s /usr/sbin/nologin appuser && \
    mkdir -p /app/state /opt/dynatrace && \
    chown -R appuser:appuser /app /opt/dynatrace /home/appuser
ENV HOME=/home/appuser
USER appuser

EXPOSE 8000

# Run Alembic migrations on container startup, then hand off to uvicorn
# (`exec` so uvicorn becomes PID 1 and receives signals properly). The
# migration is idempotent — `upgrade head` is a no-op when the schema
# already matches.
CMD ["bash", "-c", "alembic upgrade head && exec uvicorn main:app --host 0.0.0.0 --port 8000"]
